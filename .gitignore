# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local config.
# .env* catches .env.local, .env.probe and anything else a debugging
# session leaves behind -- a .env.probe was committed once, by a command
# whose cleanup line never ran because an earlier line failed.
.env*
!.env.example
*.local.yaml

# Data
*.db
*.sqlite3

# Hand-written evaluation cases belong in version control. Bulk datasets
# downloaded in Phase 7 do not — they're large and fetched by a script.
eval/data/downloaded/

# Models (downloaded on first run, ~80MB)
models/
.cache/

# Frontend
dashboard/node_modules/
dashboard/dist/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
