# Copy this to .env and edit it. .env is ignored by git; this file is not,
# so nothing real belongs in here.
#
# Every setting is explained in docs/configuration.md. See what the gateway
# actually loaded with:  python -m gateway

# --- the two that decide whether it protects anything ------------------

# shadow: every check runs and is recorded, the original text is sent anyway.
# enforce: findings are acted on.
# Shadow is the default on purpose -- run a week, read the events, fix the
# false alarms, then switch. It also means an unconfigured gateway protects
# nothing.
GATEWAY_MODE=shadow

# The provider key, held here rather than by your developers. That is what
# makes this a control: with no provider key on their machines, there is
# nothing to route around the gateway with.
# Never commit the real one.
GATEWAY_UPSTREAM_API_KEY=

# --- where requests go -------------------------------------------------

# OpenAI by default. Anything speaking the same dialect works:
#   https://api.groq.com/openai/v1          Groq
#   https://api.together.xyz/v1             Together
#   http://localhost:11434/v1               a local Ollama
GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1

# Seconds to wait for the provider. A timeout answers 504; unreachable is 502.
GATEWAY_UPSTREAM_TIMEOUT=30

# Let callers keep their own provider key and identify with X-Gateway-Key.
# Off by default: a gateway that can be walked around protects nobody.
GATEWAY_PASSTHROUGH_PROVIDER_KEY=false

# --- storage -----------------------------------------------------------

# SQLite is a file and needs nothing installed. Two gateway instances cannot
# share one, so more than one needs Postgres:
#   postgresql+asyncpg://user:password@localhost/gateway
# After changing this, run:  python -m alembic upgrade head
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# --- detection ---------------------------------------------------------

# A rules file with a mistake in it stops the gateway starting, rather than
# quietly checking less than you think it is.
GATEWAY_RULES_FILE=gateway/config/rules.yaml

# --- networking --------------------------------------------------------

# 127.0.0.1 accepts connections from this machine only, which is right for
# trying it out and wrong in a container -- use 0.0.0.0 there.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
